<?xml version="1.0" encoding="utf-8"?>
<!--
  The remote UI is reached either over a Cloudflare tunnel (https) or directly
  over the LAN (http://192.168.x.x:3080). Cleartext must therefore stay allowed
  for arbitrary hosts — this is a personal remote-control client, not a public
  store app.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
