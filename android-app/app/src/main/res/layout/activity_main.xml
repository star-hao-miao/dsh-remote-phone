<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0F1014"
    android:orientation="vertical">

    <!-- Slim top bar: whale mark · status dot · address · refresh · scan · more -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FF15171C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="4dp">

        <FrameLayout
            android:layout_width="26dp"
            android:layout_height="26dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_foreground" />

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="bottom|end"
                android:background="#FF9AA0A6" />
        </FrameLayout>

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/url_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="#FFEDEDED"
            android:textColorHint="#FF7E838C"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnConnect"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:text="@string/action_connect"
            android:textColor="#FF7FA0FF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRefresh"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:text="⟳"
            android:textColor="#FFB9C2D0"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnScan"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:text="▣"
            android:textColor="#FFB9C2D0"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnMore"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:text="⋮"
            android:textColor="#FFB9C2D0"
            android:textSize="18sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FF7FA0FF" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF0F1014" />

            <LinearLayout
                android:id="@+id/errorView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF0F1014"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/errorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/error_title"
                    android:textColor="#FFEDEDED"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/errorDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="#FF8B9099"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/error_retry"
                    android:textColor="#FF7FA0FF" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
