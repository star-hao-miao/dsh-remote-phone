# ── 构建产物与依赖 ──────────────────────────────────────────────
node_modules/
build/
.gradle/
.idea/
*.iml
local.properties
lib/
*.tsbuildinfo

# ── 本地工具链与测试环境（体积巨大，绝不入库）──────────────────
.toolchain/
.qa/
.npm-cache/

# ── 日志与系统文件 ──────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db

# ── 说明 ────────────────────────────────────────────────────────
# dist/ 里放的是构建好的 APK，**故意不忽略**：仓库要能直接下载到手机安装包。
# 如果你更希望把 APK 挂到 GitHub Release（推荐，避免每次发版给 git 历史再加 25MB），
# 就把下面两行取消注释。
# dist/
# !dist/.gitkeep
